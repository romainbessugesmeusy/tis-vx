  "title": "Dépannage Réparable",
  "htmlContent": "<div class=\"content\">\n\r\n<table width=\"100%\" >\r\n  <!--XPRINT-->\r\n  <table>\r\n  <tr>\r\n    <td></td>\r\n   <td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td>\r\n  \t\r\n  </tr>\r\n  </table>\r\n  \r\n  <!--/XPRINT-->\r\n  <tr>\r\n    <td >\n<p class=\"title\">Dépannage Réparable</p>\n\n<p class=\"para-before-table\">La zone d'application pour la réparation du faisceau de câblage est prévue pour les types de dommages suivants :</p>\n\n<table cellspacing=\"0\" cellpadding=\"2\" class=\"border-all\">\n<colgroup>\n<col width=\"20%\">\n<col width=\"80%\"></colgroup>\n\n<tr valign=\"bottom\">\n<th class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p class=\"bold\">Type de dommage</p>\n</th>\n<th class=\"border-bot\" align=\"left\" valign=\"middle\">\n<p class=\"bold\">Désignation</p>\n</th>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p>1</p>\n</td>\n<td class=\"border-bot\" align=\"left\" valign=\"middle\">\n<p>Réparation des câbles endommagés</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p>2</p>\n</td>\n<td class=\"border-bot\" align=\"left\" valign=\"middle\">\n<p>Remplacement des boîtiers de prise</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p>3</p>\n</td>\n<td class=\"border-bot\" align=\"left\" valign=\"middle\">\n<p>Remplacement des contacts à ressort individuels</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p>4</p>\n</td>\n<td class=\"border-bot\" align=\"left\" valign=\"middle\">\n<p>Remplacement des boîtiers de prise et des contacts à ressort individuels</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p>5</p>\n</td>\n<td class=\"border-bot\" align=\"left\" valign=\"middle\">\n<p>Remplacement des prises de faisceau de câblage complètes</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-right\" align=\"center\" valign=\"middle\">\n<p>6</p>\n</td>\n<td class=\"border-none\" valign=\"middle\">\n<p>Réparation des fils CAN-bus endommagés</p>\n</td>\n</tr>\n</table>\n\n<br>\n</td>\r\n  </tr>\r\n  \r\n  <tr>\r\n    <td ></td>\r\n  </tr>\r\n</table>\r\n</div>",
