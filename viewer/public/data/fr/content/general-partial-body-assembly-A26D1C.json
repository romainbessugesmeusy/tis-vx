  "htmlContent": "<div class=\"content\">\n\r\n<table width=\"100%\" >\r\n  <!--XPRINT-->\r\n  <table>\r\n  <tr>\r\n    <td><a href=\"#relatedlus\">Unités de littérature connexes</a></td>\r\n   <td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td>\r\n  \t\r\n  </tr>\r\n  </table>\r\n  <tr><td><hr size=\"1\" ></td></tr>\r\n  <!--/XPRINT-->\r\n  <tr>\r\n    <td >\r\n<DIV>\r\n<P  ><FONT STYLE=\"font-size: 12pt; \">        &nbsp;</FONT><P  ><FONT STYLE=\"font-size: 12pt;font-weight: bold; \"> Assemblage partiel de la carrosserie     &nbsp;</FONT><P  ><FONT STYLE=\"font-size: 12pt;font-weight: bold; \"> Général   &nbsp;</FONT><P  ><FONT STYLE=\"font-size: 12pt; \"> L'assemblage partiel de la carrosserie se compose des éléments suivants:   &nbsp;</FONT></DIV>\r\n<DIV>\r\n<P  >&nbsp;</DIV>\r\n<DIV>\r\n<P  ><FONT STYLE=\"font-size: 12pt; \">•&nbsp;&#9; Panneaux latéraux (voir Section 2.3.1 \"Panneau latéral\").   &nbsp;</FONT></DIV>\r\n<DIV>\r\n<P  ><FONT STYLE=\"font-size: 12pt; \">•&nbsp;&#9; Cadre de pare-brise (voir Section 2.3.2 \"Cadre de pare-brise\").   &nbsp;</FONT></DIV>\r\n<DIV>\r\n<P  ><FONT STYLE=\"font-size: 12pt; \">•&nbsp;&#9; Ensemble boîte de collision (voir Section 2.3.3 \"Ensemble boîte de collision, avant\").   &nbsp;</FONT></DIV>\r\n<DIV>\r\n<P  ><FONT STYLE=\"font-size: 12pt; \">•&nbsp;&#9; Tablier arrière (voir Section 2.3.4 \"Tablier arrière\").   &nbsp;</FONT></DIV>\r\n<DIV>\r\n<P  ><FONT STYLE=\"font-size: 12pt; \">•&nbsp;&#9; Arceau de sécurité (voir Section 2.6 \"Arceau de sécurité\").   &nbsp;</FONT></DIV>\r\n<DIV>\r\n<P  ><FONT STYLE=\"font-size: 12pt; \">•&nbsp;&#9; Cadre de châssis (voir Section 2.7.2 \"Cadre de châssis\").   &nbsp;</FONT></DIV>\r\n<DIV>\r\n<P  ><FONT STYLE=\"font-size: 12pt; \">  &nbsp;</FONT></DIV>\r\n<DIV>\r\n<P  ><FONT STYLE=\"font-size: 12pt; \">  &nbsp;</FONT><P ALIGN=\"right\" ><!-- SCDS: T9049.TIF -->\r\n<IMG src=\"/data/assets/images/5d69cc35f53b.jpg\" ALIGN=\"TOP\" ALT=\"Numéro d'objet: 2429500  Taille: PAR DÉFAUT\" HEIGHT=419 WIDTH=747 BORDER=0 USEMAP=\"#2429500.map\"><br><a href=\"javascript:TFormSubmit('A77I1IMH1FEH1','1','A77I1IMH1FEH1','detail')\"><img src=\"/data/assets/images/db1138827f57.gif\" alt=\"Cliquez ici pour l'image détaillée de l'image ci-dessus\"></a>&nbsp;<P  ><FONT STYLE=\"font-size: 12pt; \">  &nbsp;</FONT></DIV>\r\n<DIV>\r\n<P  ><FONT STYLE=\"font-size: 12pt; \">  &nbsp;</FONT><P  ><FONT STYLE=\"font-size: 12pt; \">    &nbsp;</FONT><P  ><FONT STYLE=\"font-size: 12pt;font-weight: bold; \">• Service &nbsp;</FONT><P  ><FONT STYLE=\"font-size: 12pt; \"> L'assemblage partiel de la carrosserie est fourni avec les tuyaux de radiateur, les tuyaux de chauffage, le câble de batterie et le tuyau d'embrayage.     &nbsp;</FONT></DIV>\r\n<DIV>\r\n<P  >&nbsp;&nbsp;</DIV>\r\n<DIV>\r\n<P  ><FONT STYLE=\"font-size: 12pt; \">       &nbsp;</FONT></DIV>\r\n</td>\r\n  </tr>\r\n  <tr><td><hr size=\"1\" ></td></tr>\r\n  <tr>\r\n    <td ><a id=\"relatedlus\"></a><table ><tr ><th colspan=\"2\" >Unités de littérature connexes</th></tr><tr ><td >-</td><td ><a href=\"javascript:TFormSubmit('AM5I1TOH13FH1','1','AM5I1TOH13FH1','_top')\" id=\"AM5I1TOH13FH1\" >Panneau latéral</a></td></tr><tr ><td >-</td><td ><a href=\"javascript:TFormSubmit('A54I1VGH1ENH1','1','A54I1VGH1ENH1','_top')\" id=\"A54I1VGH1ENH1\" >Cadre de pare-brise</a></td></tr><tr ><td >-</td><td ><a href=\"javascript:TFormSubmit('AS0I1UMH1PKH1','1','AS0I1UMH1PKH1','_top')\" id=\"AS0I1UMH1PKH1\" >Assemblage de structure de collision, avant</a></td></tr><tr ><td >-</td><td ><a href=\"javascript:TFormSubmit('A43I1TPH1CMH1','1','A43I1TPH1CMH1','_top')\" id=\"A43I1TPH1CMH1\" >Tablier arrière</a></td></tr><tr ><td >-</td><td ><a href=\"javascript:TFormSubmit('A83I1YKH1VOH1','1','A83I1YKH1VOH1','_top')\" id=\"A83I1YKH1VOH1\" >Arceau de sécurité</a></td></tr><tr ><td >-</td><td ><a href=\"javascript:TFormSubmit('AB6I1CQH1SFH1','1','AB6I1CQH1SFH1','_top')\" id=\"AB6I1CQH1SFH1\" >Cadre de châssis</a></td></tr></table></td>\r\n  </tr>\r\n</table>\r\n</div>",
