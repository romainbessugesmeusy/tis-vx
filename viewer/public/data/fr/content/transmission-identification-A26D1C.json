  "title": "Identification de la transmission",
  "htmlContent": "<div class=\"content\">\n\r\n<table width=\"100%\" >\r\n  <!--XPRINT-->\r\n  <table>\r\n  <tr>\r\n    <td></td>\r\n   <td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td>\r\n  \t\r\n  </tr>\r\n  </table>\r\n  \r\n  <!--/XPRINT-->\r\n  <tr>\r\n    <td >\n<p class=\"title\">Identification de la transmission</p>\n\n<table border=\"0\">\n<tr>\n<td></tr>\n\n<tr>\n<td valign=\"top\" width=\"95%\">\n<p class=\"para-before-list\">Code, numéro de transmission et code-barres\nsont sur le carter.</p>\n\n<table>\n<tr>\n<td class=\"list--arabic--number\" width=\"20\">1.</td>\n<td colspan=\"3\">Type de carter</td>\n</tr>\n\n<tr>\n<td class=\"list--arabic--number\" width=\"20\">2.</td>\n<td colspan=\"3\">Code de transmission ; premier chiffre = jeu de rapports, deuxième\nchiffre = rapport de pont final</td>\n</tr>\n\n<tr>\n<td class=\"list--arabic--number\" width=\"20\">3.</td>\n<td colspan=\"3\">Année de production</td>\n</tr>\n\n<tr>\n<td class=\"list--arabic--number\" width=\"20\">4.</td>\n<td colspan=\"3\">Numéro de série de l'année concernée</td>\n</tr>\n\n<tr>\n<td class=\"list--arabic--number\" width=\"20\">5.</td>\n<td colspan=\"3\">Indice de modification interne GETRAG</td>\n</tr>\n\n<tr>\n<td class=\"list--arabic--number\" width=\"20\">6.</td>\n<td colspan=\"3\">Numéro de pièce Opel</td>\n</tr>\n\n<tr>\n<td class=\"list--arabic--number\" width=\"20\">7.</td>\n<td colspan=\"3\">Code d'identification Opel</td>\n</tr>\n\n<tr>\n<td class=\"list--arabic--number\" width=\"20\">8.</td>\n<td colspan=\"3\">Code-barres pour le contrôle de production</td>\n</tr>\n</table>\n\n<br>\n </td>\n<td valign=\"top\" align=\"right\"><!--SCDS Link: T9153.itf-->\n<img border=\"0\" width=\"480\" height=\"600\" alt=\n\"Numéro d'objet : 2429543  Taille : PAR DÉFAUT\" align=\"TOP\" src=\"/data/assets/images/b45643ccb596.jpg\">\n<br>\n<a href=\"javascript:TFormSubmit('AYZL1HQL1ALL1','1','AYZL1HQL1ALL1','detail')\">\n<img src=\"/data/assets/images