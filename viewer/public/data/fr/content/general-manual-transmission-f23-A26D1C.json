  "htmlContent": "<div class=\"content\">\n\r\n<table width=\"100%\" >\r\n  <!--XPRINT-->\r\n  <table>\r\n  <tr>\r\n    <td></td>\r\n   <td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td>\r\n  \t\r\n  </tr>\n  </table>\r\n  \r\n  <!--/XPRINT-->\r\n  <tr>\r\n    <td >\r\n<DIV>\r\n<P  ><FONT STYLE=\"font-size: 12pt; \">        &nbsp;</FONT><P  ><FONT STYLE=\"font-size: 12pt;font-weight: bold; \"> Boîte de vitesses manuelle F23     &nbsp;</FONT><P  ><FONT STYLE=\"font-size: 12pt;font-weight: bold; \"> Général   &nbsp;</FONT><P  ><FONT STYLE=\"font-size: 12pt; \"> La Speedster/VX 220 est équipée de la boîte de vitesses F23, familière de l'Astra-G, Vectra-B et Zafira.  La F23 présente les caractéristiques suivantes:   &nbsp;</FONT></DIV>\r\n<DIV>\r\n<P  >&nbsp;</DIV>\r\n<DIV>\r\n<P  ><FONT STYLE=\"font-size: 12pt; \">•&nbsp;&#9; Couple transmissible élevé.   &nbsp;</FONT></DIV>\r\n<DIV>\r\n<P  ><FONT STYLE=\"font-size: 12pt; \">•&nbsp;&#9; Synchroniseurs sur toutes les cinq vitesses avant et la marche arrière.   &nbsp;</FONT></DIV>\r\n<DIV>\r\n<P  ><FONT STYLE=\"font-size: 12pt; \">•&nbsp;&#9; Anneaux de synchronisation revêtus de molybdène.   &nbsp;</FONT></DIV>\r\n<DIV>\r\n<P  ><FONT STYLE=\"font-size: 12pt; \">•&nbsp;&#9; Carter en deux parties.   &nbsp;</FONT></DIV>\r\n<DIV>\r\n<P  ><FONT STYLE=\"font-size: 12pt;font-weight: bold; \">• Service &nbsp;</FONT><P  ><FONT STYLE=\"font-size: 12pt; \"> La transmission est lubrifiée à vie.     &nbsp;</FONT></DIV>\r\n<DIV>\r\n<P  >&nbsp;&nbsp;</DIV>\r\n<DIV>\r\n<P  ><FONT STYLE=\"font-size: 12pt; \">       &nbsp;</FONT></DIV>\r\n</td>\r\n  </tr>\r\n  \r\n  <tr>\r\n    <td ></td>\r\n  </tr>\n</table>\r\n</div>",
