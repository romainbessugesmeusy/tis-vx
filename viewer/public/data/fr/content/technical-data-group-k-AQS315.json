  "title": "Données techniques - Groupe K",
  "htmlContent": "<div class=\"content\">\n\r\n<table width=\"100%\" >\r\n  <!--XPRINT-->\r\n  <table>\r\n  <tr>\r\n    <td></td>\r\n   <td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td>\r\n  \t\r\n  </tr>\n  </table>\n  \r\n  <!--/XPRINT-->\n  <tr>\r\n    <td >\n<p class=\"title\">Données techniques &ndash; Groupe K</p>\n\n<p class=\"topic\">Joints, Lubrifiants et Agents de verrouillage</p>\n\n<table cellspacing=\"0\" cellpadding=\"2\" class=\"border-all\">\n<colgroup>\n<col width=\"23%\">\n<col width=\"26%\">\n<col width=\"26%\">\n<col width=\"26%\"></colgroup>\n\n<tr valign=\"top\">\n<td class=\"border-right\" align=\"center\" valign=\"top\">\n<p class=\"bold\">Description</p>\n</td>\n<td class=\"border-right\" align=\"center\" valign=\"top\">\n<p class=\"bold\">Application</p>\n</td>\n<td class=\"border-right\" align=\"center\" valign=\"top\">\n<p class=\"bold\">Numéro de catalogue</p>\n</td>\n<td class=\"border-none\" align=\"center\" valign=\"top\">\n<p class=\"bold\">Numéro de pièce</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"left\" valign=\"top\">\n<p>Liquide de transmission</p>\n</td>\n<td class=\"border-botright\" align=\"left\" valign=\"top\">\n<p>Assemblage des composants de transmission rotatifs, remplissage du liquide</p>\n</td>\n<td class=\"border-botright\" align=\"center\" valign=\"top\">\n<p>19 40 764/19 40 768</p>\n</td>\n<td class=\"border-bot\" align=\"center\" valign=\"top\">\n<p>90 540 998/09 120 541</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"left\" valign=\"top\">\n<p>Graisse d'assemblage</p>\n</td>\n<td class=\"border-botright\" align=\"left\" valign=\"top\">\n<p>Insertion des bagues d'étanchéité</p>\n</td>\n<td class=\"border-botright\" align=\"center\" valign=\"top\">\n<p>19 48 603</p>\n</td>\n<td class=\"border-bot\" align=\"center\" valign=\"top\">\n<p>90 393 648</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"left\" valign=\"top\">\n<p>Graisse lubrifiante</p>\n</td>\n<td class=\"border-botright\" align=\"left\" valign=\"top\">\n<p>Pour enduire la surface de glissement du palier d'embrayage et les dents de la plaque d'embrayage</p>\n</td>\n<td class=\"border-botright\" align=\"center\" valign=\"top\">\n<p>19 48 568</p>\n</td>\n<td class=\"border-bot\" align=\"center\" valign=\"top\">\n<p>90 397 024</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"left\" valign=\"top\">\n<p>Joint d'étanchéité de surface (vert)</p>\n</td>\n<td class=\"border-botright\" align=\"left\" valign=\"top\">\n<p>Pour installer le commutateur de feu de recul</p>\n</td>\n<td class=\"border-botright\" align=\"center\" valign=\"top\">\n<p>15 03 170</p>\n</td>\n<td class=\"border-bot\" align=\"center\" valign=\"top\">\n<p>90 542 114</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"left\" valign=\"top\">\n<p>Composé de verrouillage</p>\n</td>\n<td class=\"border-botright\" align=\"left\" valign=\"top\">\n<p>Joint d'étanchéité pour les connexions boulonnées</p>\n</td>\n<td class=\"border-botright\" align=\"center\" valign=\"top\">\n<p>15 10 181</p>\n</td>\n<td class=\"border-bot\" align=\"center\" valign=\"top\">\n<p>90 542 117</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"left\" valign=\"top\">\n<p>Graisse de silicone</p>\n</td>\n<td class=\"border-botright\" align=\"left\" valign=\"top\">\n<p>Graisse pour toutes les connexions coulissantes sollicitées en température et les bagues en plastique</p>\n</td>\n<td class=\"border-botright\" align=\"center\" valign=\"top\">\n<p>19 70 206</p>\n</td>\n<td class=\"border-bot\" align=\"center\" valign=\"top\">\n<p>90 167 353</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-right\" align=\"left\" valign=\"top\">\n<p>Graisse pour roulement à billes</p>\n</td>\n<td class=\"border-right\" align=\"left\" valign=\"top\">\n<p>Pour fixer le joint et comme lubrifiant pour les cannelures</p>\n</td>\n<td class=\"border-right\" align=\"center\" valign=\"top\">\n<p>19 48 606</p>\n</td>\n<td class=\"border-none\" align=\"center\" valign=\"top\">\n<p>90 510 336</p>\n</td>\n</tr>\n</table>\n\n<br>\n \n\n<p class=\"topic\">Embrayage</p>\n\n<p>Type : Embrayage monodisque à sec</p>\n\n<table cellspacing=\"0\" cellpadding=\"2\" class=\"border-all\">\n<colgroup>\n<col width=\"25%\">\n<col width=\"37%\">\n<col width=\"39%\"></colgroup>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p class=\"bold\">Moteur</p>\n</td>\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p class=\"bold\">Épaisseur de la garniture (mm)</p>\n</td>\n<td class=\"border-bot\" align=\"center\" valign=\"middle\">\n<p class=\"bold\">Diamètre extérieur et intérieur de la garniture (mm)</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p>Z 20 LET</p>\n</td>\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p>7,65</p>\n</td>\n<td class=\"border-bot\" align=\"center\" valign=\"middle\">\n<p>228/150</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-right\" align=\"center\" valign=\"middle\">\n<p>Z 22 SE</p>\n</td>\n<td class=\"border-right\" align=\"center\" valign=\"middle\">\n<p>7,65</p>\n</td>\n<td class=\"border-none\" align=\"center\" valign=\"middle\">\n<p>228/150</p>\n</td>\n</tr>\n</table>\n\n<br>\n \n\n<p class=\"topic\">Hydraulique d'embrayage</p>\n\n<table cellspacing=\"0\" cellpadding=\"2\" class=\"border-none\">\n<colgroup>\n<col width=\"24%\">\n<col width=\"76%\"></colgroup>\n\n<tr valign=\"top\">\n<td class=\"border-none\" align=\"left\" valign=\"top\">\n<p>Fluide hydraulique :</p>\n</td>\n<td class=\"border-none\" align=\"left\" valign=\"middle\">\n<p>Fluide de frein haute performance Opel/Vauxhall. Ce liquide de frein est conforme à la norme de sécurité DOT 4 US et à la spécification SAE J 1703. Ce liquide de frein peut être mélangé avec tous les fluides conformes à ces réglementations.</p>\n</td>\n</tr>\n</table>\n\n<br>\n \n\n<p class=\"topic\">Transmission et Différentiel</p>\n\n<p class=\"topic\">Enquête</p>\n\n<table cellspacing=\"0\" cellpadding=\"2\" class=\"border-all\">\n<colgroup>\n<col>\n<col>\n<col width=\"100%\"></colgroup>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p class=\"bold\">Moteur</p>\n</td>\n<td class=\"border-bot\" colspan=\"2\" align=\"center\" valign=\"middle\">\n<p class=\"bold\">Transmission manuelle</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-right\" align=\"center\" valign=\"middle\">&nbsp;</td>\n<td class=\"border-right\" align=\"center\" valign=\"middle\">\n<p>Désignation</p>\n</td>\n<td class=\"border-none\" align=\"center\" valign=\"middle\">\n<p>Rapport de pont final</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p>Z 20 LET</p>\n</td>\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p>F23 SRT</p>\n</td>\n<td class=\"border-bot\" align=\"center\" valign=\"middle\">\n<p>3,63</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-right\" align=\"center\" valign=\"middle\">\n<p>Z 22 SE</p>\n</td>\n<td class=\"border-right\" align=\"center\" valign=\"middle\">\n<p>F23 SR</p>\n</td>\n<td class=\"border-none\" align=\"center\" valign=\"middle\">\n<p>3,95</p>\n</td>\n</tr>\n</table>\n\n<br>\n \n\n<table cellspacing=\"0\" cellpadding=\"2\" class=\"border-all\">\n<colgroup>\n<col>\n<col>\n<col width=\"100%\"></colgroup>\n\n<tr valign=\"top\">\n<td class=\"border-bot\" colspan=\"3\" align=\"center\" valign=\"middle\">\n<p class=\"bold\">Rapports de boîte de vitesses</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n&nbsp;</td>\n<td class=\"border-bot\" colspan=\"2\" align=\"center\" valign=\"middle\">\n<p>F 23</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n&nbsp;</td>\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p>SR</p>\n</td>\n<td class=\"border-bot\" align=\"center\" valign=\"middle\">\n<p>SRT</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p>1ère vitesse</p>\n</td>\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p>3,5769</p>\n</td>\n<td class=\"border-bot\" align=\"center\" valign=\"middle\">\n<p>3,5769</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p>2ème vitesse</p>\n</td>\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p>2,0217</p>\n</td>\n<td class=\"border-bot\" align=\"center\" valign=\"middle\">\n<p>2,0217</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p>3ème vitesse</p>\n</td>\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p>1,3478</p>\n</td>\n<td class=\"border-bot\" align=\"center\" valign=\"middle\">\n<p>1,3478</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p>4ème vitesse</p>\n</td>\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p>0,9767</p>\n</td>\n<td class=\"border-bot\" align=\"center\" valign=\"middle\">\n<p>0,9767</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p>5ème vitesse</p>\n</td>\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p>0,8085</p>\n</td>\n<td class=\"border-bot\" align=\"center\" valign=\"middle\">\n<p>0,79</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-right\" align=\"center\" valign=\"middle\">\n<p>Marche arrière</p>\n</td>\n<td class=\"border-right\" align=\"center\" valign=\"middle\">\n<p>3,3077</p>\n</td>\n<td class=\"border-none\" align=\"center\" valign=\"middle\">\n<p>3,3077</p>\n</td>\n</tr>\n</table>\n\n<br>\n \n\n<p class=\"topic\">Liquide de transmission</p>\n\n<table cellspacing=\"0\" cellpadding=\"2\" class=\"border-all\">\n<colgroup>\n<col>\n<col>\n<col width=\"100%\"></colgroup>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p class=\"bold\">Quantité de remplissage</p>\n</td>\n<td class=\"border-botright\" align=\"center\" valign=\"middle\">\n<p class=\"bold\">Numéro de catalogue</p>\n</td>\n<td class=\"border-bot\" align=\"center\" valign=\"middle\">\n<p class=\"bold\">Numéro de pièce</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-right\" align=\"center\" valign=\"middle\">\n<p>env. 1,55</p>\n</td>\n<td class=\"border-right\" align=\"center\" valign=\"middle\">\n<p>19 40 768</p>\n</td>\n<td class=\"border-none\" align=\"center\" valign=\"middle\">\n<p>09 120 541</p>\n</td>\n</tr>\n</table>\n\n<br>\n \n\n<table cellspacing=\"0\" cellpadding=\"2\" class=\"border-none\">\n<colgroup>\n<col width=\"24%\">\n<col width=\"76%\"></colgroup>\n\n<tr valign=\"top\">\n<td class=\"border-none\" align=\"left\" valign=\"top\">\n<p>Niveau de liquide de transmission :</p>\n</td>\n<td class=\"border-none\" align=\"left\" valign=\"middle\">\n<p>Suite à une opération de réparation de la transmission, la transmission doit être complétée jusqu'au bord inférieur de l'ouverture de niveau.</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-none\" align=\"left\" valign=\"top\">&nbsp;</td>\n<td class=\"border-none\" align=\"left\" valign=\"middle\">\n<p>Comme le liquide de transmission est rempli en usine par poids, le niveau de liquide est toujours en dessous de l'ouverture de contrôle.</p>\n</td>\n</tr>\n</table>\n\n<br>\n</td>\r\n  </tr>\r\n  \r\n  <tr>\r\n    <td ></td>\r\n  </tr>\n</table>\n</div>",
