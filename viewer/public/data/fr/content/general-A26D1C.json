ne\" valign=\"middle\">&nbsp;</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-right\" valign=\"middle\">\n<p>tous</p>\n</td>\n<td class=\"border-right\" valign=\"middle\">\n<p>93 177 449</p>\n</td>\n<td class=\"border-none\" valign=\"middle\">\n<p>12 92 338</p>\n</td>\n</tr>\n</table>\n\n<br>\n \n\n<p class=\"topic\">Sangle de retenue, ruban adhésif et tube ondulé</p>\n\n<table cellspacing=\"0\" cellpadding=\"2\" class=\"border-all\">\n<colgroup>\n<col>\n<col>\n<col width=\"100%\"></colgroup>\n\n<tr valign=\"bottom\">\n<th class=\"border-botright\" align=\"left\" valign=\"middle\">\n<p class=\"bold\">Désignation</p>\n</th>\n<th class=\"border-botright\" align=\"left\" valign=\"middle\">\n<p class=\"bold\">Référence</p>\n</th>\n<th class=\"border-bot\" align=\"left\" valign=\"middle\">\n<p class=\"bold\">Numéro de catalogue</p>\n</th>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-right\" align=\"left\" valign=\"middle\">\n<p class=\"bold\">Sangle de retenue</p>\n</td>\n<td class=\"border-right\" align=\"left\" valign=\"middle\">\n<p>&nbsp;</p>\n</td>\n<td class=\"border-none\" align=\"left\" valign=\"middle\">\n<p>&nbsp;</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-right\" align=\"left\" valign=\"middle\">\n<p>97 mm de long</p>\n</td>\n<td class=\"border-right\" align=\"left\" valign=\"middle\">\n<p>90 247 260</p>\n</td>\n<td class=\"border-none\" align=\"left\" valign=\"middle\">\n<p>12 88 880</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-right\" align=\"left\" valign=\"middle\">\n<p>120 mm de long</p>\n</td>\n<td class=\"border-right\" align=\"left\" valign=\"middle\">\n<p>90 381 846</p>\n</td>\n<td class=\"border-none\" align=\"left\" valign=\"middle\">\n<p>12 88 885</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-right\" align=\"left\" valign=\"middle\">\n<p>122 mm de long</p>\n</td>\n<td class=\"border-right\" align=\"left\" valign=\"middle\">\n<p>90 196 418</p>\n</td>\n<td class=\"border-none\" align=\"left\" valign=\"middle\">\n<p>12 88 879</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-right\" align=\"left\" valign=\"middle\">\n<p>146 mm de long</p>\n</td>\n<td class=\"border-right\" align=\"left\" valign=\"middle\">\n<p>90 493 329</p>\n</td>\n<td class=\"border-none\" align=\"left\" valign=\"middle\">\n<p>12 88 586</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-right\" align=\"left\" valign=\"middle\">\n<p>191 mm de long</p>\n</td>\n<td class=\"border-right\" align=\"left\" valign=\"middle\">\n<p>90 307 872</p>\n</td>\n<td class=\"border-none\" align=\"left\" valign=\"middle\">\n<p>12 88 882</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"left\" valign=\"middle\">\n<p>255 mm de long</p>\n</td>\n<td class=\"border-botright\" align=\"left\" valign=\"middle\">\n<p>90 039 907</p>\n</td>\n<td class=\"border-bot\" align=\"left\" valign=\"middle\">\n<p>12 88 900</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-right\" align=\"left\" valign=\"middle\">\n<p class=\"bold\">Ruban adhésif</p>\n</td>\n<td class=\"border-right\" align=\"left\" valign=\"middle\">&nbsp;</td>\n<td class=\"border-none\" align=\"left\" valign=\"middle\">&nbsp;</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-botright\" align=\"left\" valign=\"middle\">\n<p>9 mm x 0,2 mm, rouleau de 10 m</p>\n</td>\n<td class=\"border-botright\" align=\"left\" valign=\"middle\">\n<p>90 543 264</p>\n</td>\n<td class=\"border-bot\" align=\"left\" valign=\"middle\">\n<p>12 86 675</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-right\" align=\"left\" valign=\"middle\">\n<p>Tube ondulé, rouleaux de 5 m chacun</p>\n</td>\n<td class=\"border-right\" align=\"left\" valign=\"middle\">&nbsp;</td>\n<td class=\"border-none\" align=\"left\" valign=\"middle\">&nbsp;</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-right\" align=\"left\" valign=\"middle\">\n<p>Diamètre extérieur de 10 mm</p>\n</td>\n<td class=\"border-right\" align=\"left\" valign=\"middle\">\n<p>90 443 557</p>\n</td>\n<td class=\"border-none\" align=\"left\" valign=\"middle\">\n<p>12 88 103</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-right\" align=\"left\" valign=\"middle\">\n<p>Diamètre extérieur de 18 mm</p>\n</td>\n<td class=\"border-right\" align=\"left\" valign=\"middle\">\n<p>90 443 558</p>\n</td>\n<td class=\"border-none\" align=\"left\" valign=\"middle\">\n<p>12 88 104</p>\n</td>\n</tr>\n\n<tr valign=\"top\">\n<td class=\"border-right\" align=\"left\" valign=\"middle\">\n<p>Diamètre extérieur de 29 mm</p>\n</td>\n<td class=\"border-right\" align=\"left\" valign=\"middle\">\n<p>90 443 559</p>\n</td>\n<td class=\"border-none\" align=\"left\" valign=\"middle\">\n<p>12 88 102</p>\n</td>\n</tr>\n</table>\n\n<br>\n \n\n<p class=\"topic\">Faisceau de câblage avec extrémités de câble</p>\n\n<p>L'attribution des fiches de faisceau de câblage réparables aux outils de sertissage et de libération ainsi que les références et numéros de catalogue peuvent être trouvées dans les tables suivantes.</p>\n\n<p class=\"topic\">Utilisation des tables</p>\n\n<ul type=\"disc\">\n<li>La colonne 1 fournit le code de la fiche de faisceau de câblage disponible avec extrémités de câble. Ce code peut être déterminé à partir du schéma de circuit actuel.</li>\n\n<ul type=\"circle\">\n<li>Les composants avec une désignation \"X\" dans les schémas de circuit incluent des fiches et des raccords, ils sont donc distingués en ajoutant \"a\" pour les raccords et \"b\" pour les fiches.</li>\n\n<li>Si le code des composants n'est pas inclus dans la table, le faisceau de câblage complet doit être remplacé.</li>\n</ul>\n\n<li>La colonne 2 fournit la couleur de la poignée des outils de sertissage à utiliser.</li>\n\n<li>Les colonnes 3 et 4 indiquent les outils de libération pour le verrouillage primaire et secondaire.</li>\n\n<li>Les champs vides pour les outils de libération signifient que les fiches ou les raccords peuvent être libérés soit manuellement, soit à l'aide d'un tournevis disponible dans le commerce.</li>\n\n<li>Les colonnes 5 et 6 contiennent les références et numéros de catalogue des fiches de faisceau de câblage avec extrémités de câble.</li>\n</ul>\n</td>\r\n  </tr>\r\n  \r\n  <tr>\r\n    <td ></td>\r\n  </tr>\n</table>\n</div>",
